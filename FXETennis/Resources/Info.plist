<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (project.yml, INFOPLIST_FILE).
	     Only keys Xcode cannot generate from an INFOPLIST_KEY_ setting belong
	     here. This one lets UIStatusBarStyle (white, project.yml) apply
	     app-wide instead of per screen (2026-09-29). -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- fxetennis:// brings a member back from a bank's web or app check of
	     a card (3-D Secure) to Stripe's sheet, which finishes the setup.
	     Without it the member was left in Safari or their bank's app
	     (review, 2026-10-04). Handled in FXETennisApp's onOpenURL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.fxetennis.app.stripe-return</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fxetennis</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
